@FOOTNOTE{Note1,key="Note1",note="A recent GRB\protect \,221009A analysis claims consistency with holographic foam blurring~\cite {SteinbringNg2026}, though without formal statistical significance."}
@FOOTNOTE{Note2,key="Note2",note="The Mar\'{e}chal formula $S = e^{-\sigma _\phi ^2}$ (valid for $\sigma _\phi \lesssim 1$) and the temporal result $\protect \mathcal  {F}_{\protect \rm  foam}(\infty ) = e^{-\sigma _\phi ^2}$ are linked by a spatio-temporal ergodic identification: both require $r_\perp \ll D_{\protect \rm  tel}$ and $C_\alpha (\infty ;D)\to 0$. For quasi-static foam ($C_\alpha \approx 1$) or $r_\perp \gg D_{\protect \rm  tel}$, the aperture sits within a single coherence patch, the wavefront carries only a common phase offset, and $S\to 1$ even when $\sigma _\phi ^2$ is large. The transverse coherence function $\Phi (b/r_\perp )$ governs a physically distinct effect --- cross-ray correlations at angular separations $\protect \boldsymbol  {\theta }\protect \neq  \protect \boldsymbol  {\theta }'$ --- which enters the second-order coherence of extended sources (Section~\ref {sec:extended}) but not the single-aperture Strehl ratio."}
@FOOTNOTE{Note3,key="Note3",note="Explicitly, $g^{(2)}_{\protect \rm  obs}(0)-1 = \DOTSI \intop \ilimits@ d\protect \boldsymbol  {\theta }\protect \,d\protect \boldsymbol  {\theta }'\protect \, I(\protect \boldsymbol  {\theta })I(\protect \boldsymbol  {\theta }')\protect \, \langle g^{(2)}_{\protect \rm  src}(-\Delta _{\protect \boldsymbol  {\theta }\protect \boldsymbol  {\theta }'})-1\rangle _{\delta t}$ (Eq.~\ref {eq:g2obsExt}), where each ray pair contributes with its own cross-ray variance $\sigma _\Delta ^2(\tau ;\protect \boldsymbol  {\theta },\protect \boldsymbol  {\theta }')$; the Cauchy--Schwarz argument of Section~\ref {sec:siegert} does not apply."}
