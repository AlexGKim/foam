\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Maximum-signal (point-source) finite-lag Siegert discrepancy SNR for $\mathcal  {S}(\tau _{\max }) \approx 1 - e^{-2\sigma _\phi ^2}$ (Eq.~\eqref  {eq:Stc}) as a function of foam exponent $\alpha $, in the fast-foam / dynamical limit $C_\alpha \to 0$. The values shown are the upper bound for each target; partially resolved targets ($D\Delta \theta \gtrsim r_\perp $) are suppressed by $\Phi _{\rm  eff}\in [0,1]$ (Section~\ref {sec:sens-extended}). Kim~et~al.~\cite  {Kim2025} baseline (10\,m, $\epsilon = 0.39$, $\sigma _t = 13$\,ps rms), $T_{\rm  obs} = 10$\,hr per exposure (multiply SNR by $\sqrt  {10^3} \approx 31.6$ for the $10^4$\,hr campaign quoted in Sections~\ref {sec:snr_results} and~\ref {sec:conclusions}); detector-limited regime (Eq.~\eqref  {eq:snr_det_pt}). Filled circles mark the $\sigma _\phi = 0.3$ weak-foam validity boundary; curves to the right saturate at $1$. Vertical dashed lines: $\alpha = 0.54$ (Lieu--Hillman imaging exclusion at $D = 1$\,Gpc, $\lambda = 500$\,nm) and $\alpha = 2/3$ (holographic). J1330$-$0905 is evaluated on the GAIA~DR3 XP-measured Ly$\alpha $ flux with the Kollatschny~\&~Zetzl~2013 turbulent-Lorentzian core (Section~\ref {sec:candidate_sources}). Dashed curves (right axis): $|\mathcal  {S}(\tau _{\max })|$.}}{15}{figure.1}\protected@file@percent }
\newlabel{fig:snr_vs_alpha_pt}{{1}{15}{Maximum-signal (point-source) finite-lag Siegert discrepancy SNR for $\mathcal {S}(\tau _{\max }) \approx 1 - e^{-2\sigma _\phi ^2}$ (Eq.~\eqref {eq:Stc}) as a function of foam exponent $\alpha $, in the fast-foam / dynamical limit $C_\alpha \to 0$. The values shown are the upper bound for each target; partially resolved targets ($D\Delta \theta \gtrsim r_\perp $) are suppressed by $\Phi _{\rm eff}\in [0,1]$ (Section~\ref {sec:sens-extended}). Kim~et~al.~\cite {Kim2025} baseline (10\,m, $\epsilon = 0.39$, $\sigma _t = 13$\,ps rms), $T_{\rm obs} = 10$\,hr per exposure (multiply SNR by $\sqrt {10^3} \approx 31.6$ for the $10^4$\,hr campaign quoted in Sections~\ref {sec:snr_results} and~\ref {sec:conclusions}); detector-limited regime (Eq.~\eqref {eq:snr_det_pt}). Filled circles mark the $\sigma _\phi = 0.3$ weak-foam validity boundary; curves to the right saturate at $1$. Vertical dashed lines: $\alpha = 0.54$ (Lieu--Hillman imaging exclusion at $D = 1$\,Gpc, $\lambda = 500$\,nm) and $\alpha = 2/3$ (holographic). J1330$-$0905 is evaluated on the GAIA~DR3 XP-measured Ly$\alpha $ flux with the Kollatschny~\&~Zetzl~2013 turbulent-Lorentzian core (Section~\ref {sec:candidate_sources}). Dashed curves (right axis): $|\mathcal {S}(\tau _{\max })|$}{figure.1}{}}
