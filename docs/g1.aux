\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Detection SNR for the foam amplitude $A_{\rm  eff}$ as a function of foam exponent $\alpha $ ($A_\alpha = 1$, $D_C = 13.87$\,Gpc). Blue curves: marginal SNR (all four parameters $A_{\rm  eff},T_0,\mu ,y$ free). Red curves: conditional SNR ($\mu ,y$ held fixed), which is $\sim 6\times $ higher. Solid: FIRAS; dashed: PIXIE (noise floor $\sim 10^3\times $ lower). The dotted horizontal line marks SNR\,$=1$; vertical dashed lines mark the spectroscopic lower bounds from BzK\,4892 ($\alpha \gtrsim 0.58$) and GRB\,221009A ($\alpha \gtrsim 0.64$), and the holographic prediction $\alpha =2/3$.}}{9}{figure.1}\protected@file@percent }
\newlabel{fig:cmb_snr}{{1}{9}{Detection SNR for the foam amplitude $A_{\rm eff}$ as a function of foam exponent $\alpha $ ($A_\alpha = 1$, $D_C = 13.87$\,Gpc). Blue curves: marginal SNR (all four parameters $A_{\rm eff},T_0,\mu ,y$ free). Red curves: conditional SNR ($\mu ,y$ held fixed), which is $\sim 6\times $ higher. Solid: FIRAS; dashed: PIXIE (noise floor $\sim 10^3\times $ lower). The dotted horizontal line marks SNR\,$=1$; vertical dashed lines mark the spectroscopic lower bounds from BzK\,4892 ($\alpha \gtrsim 0.58$) and GRB\,221009A ($\alpha \gtrsim 0.64$), and the holographic prediction $\alpha =2/3$}{figure.1}{}}
\citation{McEnery2019}
\citation{Caputo2022}
\citation{DeAngelis2017}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Foam-induced bias in the recovered CMB temperature, $|\Delta T_0|/\sigma (T_0)$, as a function of foam exponent $\alpha $ when foam at amplitude $A_{\rm  eff}$ ($A_\alpha =1$, $D_C=13.87$\,Gpc) is present but omitted from the spectral fit. Solid: FIRAS with $\sigma (T_0)=5.7\times 10^{-4}$\,K~\cite  {Fixsen2009}; dashed: PIXIE with $\sigma (T_0)\approx 5.7\times 10^{-7}$\,K (noise floor $\sim 10^3\times $ lower). The dotted horizontal line marks $|\Delta T_0|=\sigma (T_0)$; the FIRAS crossover occurs at $\alpha \approx 0.518$. Vertical dashed lines mark the spectroscopic lower bounds and the holographic prediction $\alpha =2/3$ (as in Fig.~\ref {fig:cmb_snr}).}}{10}{figure.2}\protected@file@percent }
\newlabel{fig:cmb_bias}{{2}{10}{Foam-induced bias in the recovered CMB temperature, $|\Delta T_0|/\sigma (T_0)$, as a function of foam exponent $\alpha $ when foam at amplitude $A_{\rm eff}$ ($A_\alpha =1$, $D_C=13.87$\,Gpc) is present but omitted from the spectral fit. Solid: FIRAS with $\sigma (T_0)=5.7\times 10^{-4}$\,K~\cite {Fixsen2009}; dashed: PIXIE with $\sigma (T_0)\approx 5.7\times 10^{-7}$\,K (noise floor $\sim 10^3\times $ lower). The dotted horizontal line marks $|\Delta T_0|=\sigma (T_0)$; the FIRAS crossover occurs at $\alpha \approx 0.518$. Vertical dashed lines mark the spectroscopic lower bounds and the holographic prediction $\alpha =2/3$ (as in Fig.~\ref {fig:cmb_snr})}{figure.2}{}}
