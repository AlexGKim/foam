\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Detection SNR for the foam amplitude $A_{\rm  eff}$ as a function of foam exponent $\alpha $ ($A_\alpha =1$, $D_C=13.87$\,Gpc). Blue curves: marginal SNR (all four parameters $A_{\rm  eff},T_0,\mu ,y$ free). Red curves: conditional SNR ($\mu ,y$ held fixed), which is $\sim 6\times $ higher. Solid: FIRAS; dashed: PIXIE (noise floor $\sim 10^3\times $ lower). The dotted horizontal line marks SNR\,$=1$; vertical dashed lines mark the spectroscopic lower bound from GRB\,221009A ($\alpha \gtrsim 0.63$) and the holographic prediction $\alpha =2/3$.}}{12}{figure.1}\protected@file@percent }
\newlabel{fig:cmb_snr}{{1}{12}{Detection SNR for the foam amplitude $A_{\rm eff}$ as a function of foam exponent $\alpha $ ($A_\alpha =1$, $D_C=13.87$\,Gpc). Blue curves: marginal SNR (all four parameters $A_{\rm eff},T_0,\mu ,y$ free). Red curves: conditional SNR ($\mu ,y$ held fixed), which is $\sim 6\times $ higher. Solid: FIRAS; dashed: PIXIE (noise floor $\sim 10^3\times $ lower). The dotted horizontal line marks SNR\,$=1$; vertical dashed lines mark the spectroscopic lower bound from GRB\,221009A ($\alpha \gtrsim 0.63$) and the holographic prediction $\alpha =2/3$}{figure.1}{}}
