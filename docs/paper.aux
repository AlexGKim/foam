\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Finite-lag Siegert discrepancy SNR for $\mathcal  {S}(\tau _L) = e^{-2}(1 - e^{-2\sigma _\phi ^2})$ (Eq.~\eqref  {eq:Stc}) as a function of foam exponent $\alpha $, in the dynamical-foam limit $C_\alpha \to 0$. Kim~et~al.~\cite  {Kim2025} baseline (10\,m, $\epsilon = 0.39$, $\sigma _t = 13$\,ps rms), $T_{\rm  obs} = 10$\,hr per exposure (multiply SNR by $\sqrt  {10^3} \approx 31.6$ for the $10^4$\,hr campaign quoted in Sections~\ref {sec:snr_results} and~\ref {sec:conclusions}); detector-limited regime (Eq.~\eqref  {eq:snr_det_pt}). Filled circles mark the $\sigma _\phi = 0.3$ weak-foam validity boundary; curves to the right saturate at $e^{-2} \approx 0.135$. Vertical dashed lines: $\alpha = 0.54$ (Lieu--Hillman imaging exclusion at $D = 1$\,Gpc, $\lambda = 500$\,nm) and $\alpha = 2/3$ (holographic). J1330$-$0905 is evaluated on the GAIA~DR3 XP-measured Ly$\alpha $ flux with the Kollatschny~\&~Zetzl~2013 turbulent-Lorentzian core (Section~\ref {sec:candidate_sources}). Dashed curves (right axis): $|\mathcal  {S}(\tau _L)|$.}}{16}{figure.1}\protected@file@percent }
\newlabel{fig:snr_vs_alpha_pt}{{1}{16}{Finite-lag Siegert discrepancy SNR for $\mathcal {S}(\tau _L) = e^{-2}(1 - e^{-2\sigma _\phi ^2})$ (Eq.~\eqref {eq:Stc}) as a function of foam exponent $\alpha $, in the dynamical-foam limit $C_\alpha \to 0$. Kim~et~al.~\cite {Kim2025} baseline (10\,m, $\epsilon = 0.39$, $\sigma _t = 13$\,ps rms), $T_{\rm obs} = 10$\,hr per exposure (multiply SNR by $\sqrt {10^3} \approx 31.6$ for the $10^4$\,hr campaign quoted in Sections~\ref {sec:snr_results} and~\ref {sec:conclusions}); detector-limited regime (Eq.~\eqref {eq:snr_det_pt}). Filled circles mark the $\sigma _\phi = 0.3$ weak-foam validity boundary; curves to the right saturate at $e^{-2} \approx 0.135$. Vertical dashed lines: $\alpha = 0.54$ (Lieu--Hillman imaging exclusion at $D = 1$\,Gpc, $\lambda = 500$\,nm) and $\alpha = 2/3$ (holographic). J1330$-$0905 is evaluated on the GAIA~DR3 XP-measured Ly$\alpha $ flux with the Kollatschny~\&~Zetzl~2013 turbulent-Lorentzian core (Section~\ref {sec:candidate_sources}). Dashed curves (right axis): $|\mathcal {S}(\tau _L)|$}{figure.1}{}}
