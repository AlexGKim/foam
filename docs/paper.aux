\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Extended-source zero-lag bunching suppression $\delta g^{(2)}(0)$ SNR for $|\mathcal  {S}(0)| = 1 - e^{2s^2}\,\mathrm  {erfc}(\sqrt  {2}\,s)$ with $s = \sigma _0/\tau _L$ (Eq.~\eqref  {eq:deltag2}), as a function of foam exponent $\alpha $, on the six representative targets. Instrument and integration as Figure~\ref {fig:snr_vs_alpha_pt}; SNR from Eq.~\eqref  {eq:snr_det_ext}. All sources are in the fully-resolved limit $\Phi _{\rm  eff} = 0$ (signals scale by $\sqrt  {1 - \Phi _{\rm  eff}}$ for partially resolved sources; Section~\ref {sec:sens-extended}). Filled circles mark the $s = 0.3$ linear-approximation validity boundary. Vertical dashed lines: $\alpha = 0.54$ and $\alpha = 2/3$ (holographic). J1330$-$0905 (Section~\ref {sec:candidate_sources}) is included on the Kollatschny~\&~Zetzl~2013 turbulent-Lorentzian basis (FWHM$_{\rm  turb}\sim 3800$\,km\,s$^{-1}$ for the Ly$\alpha $+N\,V emitting region~\cite  {Kollatschny2013}). Dashed curves (right axis) show the corresponding Siegert discrepancy amplitude $|\mathcal  {S}(0)|$ for each source.}}{17}{figure.2}\protected@file@percent }
\newlabel{fig:snr_vs_alpha_ext}{{2}{17}{Extended-source zero-lag bunching suppression $\delta g^{(2)}(0)$ SNR for $|\mathcal {S}(0)| = 1 - e^{2s^2}\,\mathrm {erfc}(\sqrt {2}\,s)$ with $s = \sigma _0/\tau _L$ (Eq.~\eqref {eq:deltag2}), as a function of foam exponent $\alpha $, on the six representative targets. Instrument and integration as Figure~\ref {fig:snr_vs_alpha_pt}; SNR from Eq.~\eqref {eq:snr_det_ext}. All sources are in the fully-resolved limit $\Phi _{\rm eff} = 0$ (signals scale by $\sqrt {1 - \Phi _{\rm eff}}$ for partially resolved sources; Section~\ref {sec:sens-extended}). Filled circles mark the $s = 0.3$ linear-approximation validity boundary. Vertical dashed lines: $\alpha = 0.54$ and $\alpha = 2/3$ (holographic). J1330$-$0905 (Section~\ref {sec:candidate_sources}) is included on the Kollatschny~\&~Zetzl~2013 turbulent-Lorentzian basis (FWHM$_{\rm turb}\sim 3800$\,km\,s$^{-1}$ for the Ly$\alpha $+N\,V emitting region~\cite {Kollatschny2013}). Dashed curves (right axis) show the corresponding Siegert discrepancy amplitude $|\mathcal {S}(0)|$ for each source}{figure.2}{}}
