\bibitem [{Note2()}]{Note2}%
  \BibitemOpen
  \bibinfo {note} {The Mar\'{e}chal formula $S = e^{-\sigma _\phi ^2}$ (valid
  for $\sigma _\phi \lesssim 1$) and the temporal result $\protect \mathcal
  {F}_{\protect \rm foam}(\infty ) = e^{-\sigma _\phi ^2}$ are linked by a
  spatio-temporal ergodic identification: both require $r_\perp \ll D_{\protect
  \rm tel}$ and $C_\alpha (\infty ;D)\to 0$. For quasi-static foam ($C_\alpha
  \approx 1$) or $r_\perp \gg D_{\protect \rm tel}$, the aperture sits within a
  single coherence patch, the wavefront carries only a common phase offset, and
  $S\to 1$ even when $\sigma _\phi ^2$ is large. The transverse coherence
  function $\Phi (b/r_\perp )$ governs a physically distinct effect ---
  cross-ray correlations at angular separations $\protect \boldsymbol {\theta
  }\protect \neq \protect \boldsymbol {\theta }'$ --- which enters the
  second-order coherence of extended sources (Section~\ref {sec:extended}) but
  not the single-aperture Strehl ratio.}\BibitemShut {Stop}%
